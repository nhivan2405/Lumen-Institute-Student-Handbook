# ================================================================
# CẤU HÌNH LOCAL CHO TRỢ LÝ RÔ AI
# ================================================================
# Copy file này thành `.env`, sau đó chỉ điền giá trị thật ở máy cá nhân.
# `.env` đã nằm trong .gitignore, KHÔNG commit API key lên Git.

# --- Gemini: model sinh câu trả lời (generation inference trên Google) ---
# Lấy key từ Google AI Studio / tài khoản được cấp. Giữ trống nếu mới demo khung.
GEMINI_API_KEY=

# Model ID được truyền vào client.models.generate_content() trong llm_service.py.
# Xác nhận model/quota tồn tại trong tài khoản trước khi chạy demo có Gemini.
GEMINI_MODEL=gemini-3.5-flash

# --- Embedding: model tạo vector, chạy local trong embedding_service.py ---
# Đổi model này bắt buộc phải xóa/re-index vectors Qdrant cũ.
# Model cần được tải sẵn local trước ngày demo; app không tự tải lúc upload.
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# --- RAG retrieval: tham số baseline, không phải giá trị tối ưu tuyệt đối ---
# Số chunks gần nhất Qdrant trả về để làm evidence cho một câu hỏi.
RAG_TOP_K=4

# Chunk size/overlap tính theo KÝ TỰ của RecursiveCharacterTextSplitter, không phải token.
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# --- Upload: giới hạn server-side để chặn file quá lớn trước khi index ---
MAX_UPLOAD_MB=20

# --- Local API ---
# Port 8123 đã được kiểm tra không bị Windows chặn trên máy này.
# Streamlit đọc biến môi trường RO_AI_API_URL khi cần đổi endpoint.
RO_AI_API_URL=http://127.0.0.1:8123/api
